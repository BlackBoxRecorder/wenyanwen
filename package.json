{
  "name": "wenyanwen",
  "version": "0.1.0",
  "description": "文言文标记语言编译器 - 将 .wyw 文件编译为排版精美的 HTML 页面",
  "type": "module",
  "main": "./vendor/wyw/dist/index.js",
  "bin": {
    "wyw": "./vendor/wyw/bin/wyw.js"
  },
  "scripts": {
    "build": "node web/build.js",
    "editor:setup": "cd vendor/wyw && npm install && npm run build:browser",
    "editor:start": "node editor/server.js"
  },
  "keywords": [
    "文言文",
    "classical-chinese",
    "markup",
    "typography"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "handlebars": "^4.7.9",
    "express": "^4.21.0",
    "cors": "^2.8.5"
  }
}